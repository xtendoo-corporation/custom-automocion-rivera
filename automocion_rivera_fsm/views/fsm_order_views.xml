<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vista árbol -->
        <record id="view_automocion_fsm_order_tree" model="ir.ui.view">
            <field name="name">automocion.fsm.order.tree</field>
            <field name="model">automocion.fsm.order</field>
            <field name="arch" type="xml">
                <list string="Órdenes de Trabajo">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="insurance_partner_id"/>
                    <field name="location_id"/>
                    <field name="priority_level" widget="priority"/>
                    <field name="responsible_id"/>
                    <field name="date_scheduled"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>
        <!-- Vista formulario -->
        <record id="view_automocion_fsm_order_form" model="ir.ui.view">
            <field name="name">automocion.fsm.order.form</field>
            <field name="model">automocion.fsm.order</field>
            <field name="arch" type="xml">
                <form string="Orden de Trabajo">
                    <header>
                        <button name="action_start_work" string="Iniciar Trabajo" type="object" class="btn-primary" invisible="date_start"/>
                        <button name="action_finish_work" string="Finalizar Trabajo" type="object" class="btn-primary" invisible="not date_start or date_end"/>
                        <button name="action_create_repair" string="Crear Parte de Reparación" type="object" class="btn-secondary"/>
                        <button name="action_create_sale_order" string="Crear Orden de Venta" type="object" class="btn-secondary"/>
                        <button name="action_print_order" string="Imprimir" type="object" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_repairs" type="object" class="oe_stat_button" icon="fa-wrench" invisible="repair_count == 0">
                                <field name="repair_count" widget="statinfo" string="Reparaciones"/>
                            </button>
                            <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="sale_count == 0">
                                <field name="sale_count" widget="statinfo" string="Órdenes de Venta"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group name="customer_info" string="Información del Cliente">
                                <field name="partner_id" required="1"/>
                                <field name="insurance_partner_id" domain="[('is_insurance_company', '=', True)]"/>
                                <field name="franchise_amount" invisible="not insurance_partner_id" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="contact_id" domain="[('parent_id', '=', partner_id)]"/>
                                <field name="location_id" domain="[('parent_id', '=', partner_id)]"/>
                            </group>
                            <group name="service_info" string="Información del Trabajo">
                                <field name="responsible_id"/>
                                <field name="person_ids" widget="many2many_tags"/>
                                <field name="priority_level" widget="priority"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group>
                            <group name="basic_info" string="Información Básica">
                                <field name="description" placeholder="Describe el trabajo a realizar..."/>
                            </group>
                            <group name="scheduling" string="Programación">
                                <field name="date_scheduled"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="duration" widget="float_time"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notas">
                                <group>
                                    <field name="internal_note" string="Notas Internas"/>
                                    <field name="customer_note" string="Notas del Cliente"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Acción de ventana -->
        <record id="action_fsm_order_tree" model="ir.actions.act_window">
            <field name="name">Órdenes de Trabajo</field>
            <field name="res_model">automocion.fsm.order</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
