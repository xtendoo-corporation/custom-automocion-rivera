<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia del formulario de contacto para añadir el campo Aseguradora -->
    <record id="view_partner_form_insurance" model="ir.ui.view">
        <field name="name">res.partner.form.insurance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Añadir el campo en la sección de Ventas y Compras -->
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="is_insurance_company"/>
            </xpath>
        </field>
    </record>

    <!-- Herencia de la vista lista para mostrar el campo -->
    <record id="view_partner_tree_insurance" model="ir.ui.view">
        <field name="name">res.partner.tree.insurance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_insurance_company" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Herencia de la vista de búsqueda para añadir el filtro -->
    <record id="view_partner_search_insurance" model="ir.ui.view">
        <field name="name">res.partner.search.insurance</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter
                    name="insurance_companies"
                    string="Aseguradoras"
                    domain="[('is_insurance_company', '=', True)]"
                    help="Contactos marcados como compañías aseguradoras"/>
            </xpath>
        </field>
    </record>
</odoo>
